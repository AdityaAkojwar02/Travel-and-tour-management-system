
import tkinter as tk
from tkinter import ttk, messagebox
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import os

# ---------------- DATA FILES ----------------

CUSTOMER_FILE = "customers.csv"
BOOKING_FILE = "bookings.csv"

packages = {
    "Goa Tour": 8000,
    "Manali Tour": 12000,
    "Mumbai Tour": 5000,
    "Kashmir Tour": 18000,
    "Jaipur Tour": 9000,
    "Kerala Tour": 15000
}

if os.path.exists(CUSTOMER_FILE):
    customers = pd.read_csv(CUSTOMER_FILE)
else:
    customers = pd.DataFrame(
        columns=["Name", "Phone", "Email"]
    )

if os.path.exists(BOOKING_FILE):
    bookings = pd.read_csv(BOOKING_FILE)
else:
    bookings = pd.DataFrame(
        columns=["Booking ID", "Customer", "Package",
                 "Persons", "Price", "Total", "Status"]
    )

# ---------------- FUNCTIONS ----------------

def save_data():
    customers.to_csv(CUSTOMER_FILE, index=False)
    bookings.to_csv(BOOKING_FILE, index=False)


def add_customer():
    global customers

    name = name_entry.get().strip()
    phone = phone_entry.get().strip()
    email = email_entry.get().strip()

    if not name or not phone or not email:
        messagebox.showwarning("Warning", "Fill all customer details")
        return

    if phone in customers["Phone"].astype(str).values:
        messagebox.showerror("Error", "Phone number already exists")
        return

    customers.loc[len(customers)] = [name, phone, email]

    save_data()
    display_customers()

    name_entry.delete(0, tk.END)
    phone_entry.delete(0, tk.END)
    email_entry.delete(0, tk.END)

    messagebox.showinfo("Success", "Customer added successfully")


def display_customers():
    for item in customer_table.get_children():
        customer_table.delete(item)

    for _, row in customers.iterrows():
        customer_table.insert("", tk.END, values=list(row))


def update_price(event=None):
    package = package_combo.get()
    price_label.config(
        text=f"Price per person: ₹{packages.get(package, 0):,}"
    )


def book_package():
    global bookings

    customer = booking_customer.get().strip()
    package = package_combo.get()
    persons = persons_entry.get().strip()

    if not customer or not package or not persons:
        messagebox.showwarning("Warning", "Fill all booking details")
        return

    if customer not in customers["Name"].astype(str).values:
        messagebox.showerror(
            "Error", "Please add the customer first"
        )
        return

    try:
        persons = int(persons)
        if persons <= 0:
            raise ValueError
    except ValueError:
        messagebox.showerror(
            "Error", "Enter a valid number of persons"
        )
        return

    price = packages[package]
    total = price * persons

    booking_id = (
        int(pd.to_numeric(
            bookings["Booking ID"], errors="coerce"
        ).max()) + 1
        if len(bookings) and
        pd.to_numeric(
            bookings["Booking ID"], errors="coerce"
        ).notna().any()
        else 1001
    )

    bookings.loc[len(bookings)] = [
        booking_id, customer, package,
        persons, price, total, "Confirmed"
    ]

    save_data()
    display_bookings()

    booking_customer.set("")
    package_combo.set("")
    persons_entry.delete(0, tk.END)
    price_label.config(text="Price per person: ₹0")

    messagebox.showinfo(
        "Booking Successful",
        f"Booking ID: {booking_id}\n"
        f"Customer: {customer}\n"
        f"Package: {package}\n"
        f"Total Amount: ₹{total:,}"
    )


def display_bookings(data=None):
    for item in booking_table.get_children():
        booking_table.delete(item)

    records = bookings if data is None else data

    for _, row in records.iterrows():
        booking_table.insert("", tk.END, values=list(row))


def search_booking():
    query = search_entry.get().strip().lower()

    if not query:
        display_bookings()
        return

    result = bookings[
        bookings["Customer"].astype(str).str.lower().str.contains(
            query, na=False
        )
        |
        bookings["Package"].astype(str).str.lower().str.contains(
            query, na=False
        )
        |
        bookings["Booking ID"].astype(str).str.contains(
            query, na=False
        )
    ]

    display_bookings(result)


def cancel_booking():
    global bookings

    selected = booking_table.selection()

    if not selected:
        messagebox.showwarning(
            "Warning", "Select a booking first"
        )
        return

    booking_id = str(
        booking_table.item(selected[0])["values"][0]
    )

    if not messagebox.askyesno(
        "Confirm", "Cancel this booking?"
    ):
        return

    mask = bookings["Booking ID"].astype(str) == booking_id
    bookings.loc[mask, "Status"] = "Cancelled"

    save_data()
    display_bookings()

    messagebox.showinfo("Success", "Booking cancelled")


def show_statistics():
    confirmed = bookings[
        bookings["Status"] == "Confirmed"
    ]

    total_bookings = len(bookings)
    active_bookings = len(confirmed)
    cancelled = len(bookings) - active_bookings
    revenue = pd.to_numeric(
        confirmed["Total"], errors="coerce"
    ).sum()

    popular = (
        confirmed["Package"].value_counts().idxmax()
        if not confirmed.empty else "No bookings"
    )

    result = f"""
    TRAVEL AGENCY STATISTICS

    Total Customers: {len(customers)}

    Total Bookings: {total_bookings}

    Confirmed Bookings: {active_bookings}

    Cancelled Bookings: {cancelled}

    Total Revenue: ₹{revenue:,.2f}

    Most Popular Package:
    {popular}
    """

    messagebox.showinfo("Statistics", result)


def show_chart():
    confirmed = bookings[
        bookings["Status"] == "Confirmed"
    ]

    if confirmed.empty:
        messagebox.showwarning(
            "Warning", "No confirmed bookings available"
        )
        return

    counts = confirmed["Package"].value_counts()

    plt.figure(figsize=(9, 5))
    counts.plot(kind="bar")

    plt.title("Tour Package Booking Analysis")
    plt.xlabel("Tour Packages")
    plt.ylabel("Number of Bookings")
    plt.xticks(rotation=30, ha="right")
    plt.tight_layout()
    plt.show()


def show_revenue_chart():
    confirmed = bookings[
        bookings["Status"] == "Confirmed"
    ]

    if confirmed.empty:
        messagebox.showwarning(
            "Warning", "No revenue data available"
        )
        return

    revenue = confirmed.groupby("Package")["Total"].sum()

    plt.figure(figsize=(9, 5))
    revenue.plot(kind="pie", autopct="%1.1f%%")

    plt.title("Revenue by Tour Package")
    plt.ylabel("")
    plt.tight_layout()
    plt.show()


